{
  "name": "halabi-services",
  "type": "module",
  "version": "1.0.0",
  "description": "cashier app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package-mac": "electron-packager . --overwrite --platform=darwin --arch=x64 --icon=assets/icons/mac/icon.icns --prune=true --out=release-builds",
    "package-win": "electron-packager . cashier-app --overwrite --asar --platform=win32 --arch=x64 --icon=assets/icons/win/icon.ico --prune=true --out=release-builds",
    "package-linux": "electron-packager . cashier-app --overwrite --asar=true --platform=linux --arch=x64 --icon=assets/icons/png/1024x1024.png --prune=true --out=release-builds"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "electron": "^34.0.0",
    "express": "^4.21.2",
    "jose": "^6.2.3",
    "luxon": "^3.7.2",
    "mssql": "^12.5.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron-packager": "^17.1.2"
  }
}
